{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/main",
    "src/shared",
    "src/i18n/core.ts",
    "src/i18n/en.ts",
    "src/i18n/zh.ts",
    "electron.vite.config.ts",
    "tests/e2e"
  ]
}
